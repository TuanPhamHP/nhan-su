      "refType": "{tùy}",
      "hasEntityId": "{tùy}",
      "screen": "{tùy theo refType test}",
      "params": {},
      "trigger": "ADMIN gọi /v1/notifications/test-fcm hoặc /v1/notifications/test",
      "recipients": ["employee theo employeeId"],
      "frequency": "manual",
      "note": "Mobile có thể skip handle hoặc hiện toast generic"
    }
