{
  "$schema": "https://json-schema.org/draft-07/schema",
  "version": "1.0.0",
  "lastUpdated": "2026-06-29",
  "description": "Mapping NotificationType → mobile navigation route. App mobile dùng JSON này khi user tap vào notification để biết cần mở screen nào với param gì.",

  "fcmPayloadShape": {
    "category": {
      "type": "enum",
      "values": ["ATTENDANCE", "LEAVE", "EVENT", "REQUEST"],
      "note": "Mobile có thể dùng để route đến tab tương ứng trong notification center"
    },
    "type": {
      "type": "enum",
      "note": "Key của mục `notifications` bên dưới. Mobile lookup để biết screen + params"
    },
    "refType": {
      "type": "string",
      "note": "Tên entity. Empty string ('') nếu là attendance reminder/late/missing"
    },
    "id": {
      "type": "string",
      "note": "Entity ID dùng để navigate. Empty string ('') nếu attendance"
    },
    "notificationId": {
      "type": "string",
      "note": "ID record Notification trong DB. Mobile dùng để mark read sau khi mở. '0' nếu là test"
    },
    "title": "string — bản sao của notification.title",
    "body": "string — bản sao của notification.body"
  },

  "fallbackBehavior": {
    "unknownType": "Mở Notification Center và highlight notification có notificationId tương ứng",
    "missingId": "Mở list screen của module (vd. /leave thay vì /leave/123)",
    "afterNavigate": "Gọi PATCH /v1/notifications/{notificationId}/read để mark read (skip nếu notificationId === '0')"
  },

  "notifications": {
    "LATE": {
      "category": "ATTENDANCE",
      "refType": "",
      "hasEntityId": false,
      "screen": "AttendanceList",
      "params": { "date": "today" },
      "webUrl": "/attendance?date={today}",
      "trigger": "Check-in trễ — lateMinutes > 0",
      "recipients": ["owner", "hr"],
      "frequency": "real-time"
    },

    "MISSING_CHECKOUT": {
      "category": "ATTENDANCE",
      "refType": "",
      "hasEntityId": false,
      "screen": "AttendanceList",
      "params": { "date": "yesterday" },
      "webUrl": "/attendance?date={yesterday}",
      "trigger": "Cron 23:50 — phát hiện không check-out hôm đó",
      "recipients": ["owner"],
      "frequency": "daily cron"
    },

    "CHECKIN_REMINDER": {
      "category": "ATTENDANCE",
      "refType": "",
      "hasEntityId": false,
      "screen": "AttendanceCheckIn",
      "params": {},
      "webUrl": "/attendance?date={today}",
      "trigger": "Cron mỗi 5 phút — 10 phút trước giờ ca bắt đầu",
      "recipients": ["owner"],
      "frequency": "every 5 minutes"
    },

    "CHECKOUT_REMINDER": {
      "category": "ATTENDANCE",
      "refType": "",
      "hasEntityId": false,
      "screen": "AttendanceCheckOut",
      "params": {},
      "webUrl": "/attendance?date={today}",
      "trigger": "Cron mỗi 5 phút — 10 phút trước giờ ca kết thúc (đã check-in)",
      "recipients": ["owner"],
      "frequency": "every 5 minutes"
    },

