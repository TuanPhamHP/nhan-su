  "exclusions": {
    "general_request": "Các type GENERAL_REQUEST_* đã được bỏ qua theo yêu cầu — sẽ thêm sau"
  },

  "implementationGuide": {
    "flutter": "Switch trên `data['type']`, gọi `Navigator.pushNamed(context, screen, arguments: {...params with id substituted})`. Sau push thì gọi API mark-read nếu notificationId !== '0'.",
    "ios_native": "Trong `didReceive response: UNNotificationResponse`, parse userInfo, switch trên type, push view controller tương ứng.",
    "android_native": "Trong `MessagingService.onMessageReceived`, build PendingIntent với extras từ data, set vào NotificationCompat.Builder."
  }
}
