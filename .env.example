# API key gửi kèm mỗi request (header)
NUXT_PUBLIC_API_KEY=your-api-key-here

# Base URL của REST API backend (server-only)
NUXT_PUBLIC_BASE_API_URL=http://localhost:3000

# Firebase Client SDK — lấy tại Firebase Console → Project Settings → General → Your apps
NUXT_PUBLIC_FIREBASE_API_KEY=
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NUXT_PUBLIC_FIREBASE_PROJECT_ID=
NUXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NUXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NUXT_PUBLIC_FIREBASE_APP_ID=
# VAPID key — Firebase Console → Project Settings → Cloud Messaging → Web Push certificates
NUXT_PUBLIC_FIREBASE_VAPID_KEY=
